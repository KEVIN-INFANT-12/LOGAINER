# Smart Logistics & Disaster Response — Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase Configuration (required)
# Get these from: https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# App Configuration (optional)
# Default map center coordinates (NER India - Guwahati)
VITE_MAP_DEFAULT_LAT=26.1445
VITE_MAP_DEFAULT_LNG=91.7362
VITE_MAP_DEFAULT_ZOOM=12

# App Info
VITE_APP_NAME=Smart Logistics
VITE_APP_VERSION=2.0.0

# Routing API (optional — defaults to free OSRM public server)
# To use a private OSRM instance or OpenRouteService, set the base URL here
VITE_ROUTING_API_URL=https://router.project-osrm.org

# Proximity Alert Radius (km) — how close an incident must be to trigger a driver alert
VITE_ALERT_RADIUS_KM=15

# Max media file upload size in MB (for citizen submissions and evidence uploads)
VITE_MAX_FILE_SIZE_MB=50

# Unified FastAPI Backend API URL
VITE_API_URL=http://localhost:8000/api/v1
