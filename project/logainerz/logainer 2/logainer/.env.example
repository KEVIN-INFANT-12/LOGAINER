# LOGAINER Unified Platform Environment Configuration
# Copy this file to .env and configure your production settings

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Weather API (OpenWeatherMap) - Optional, fallback simulation active if omitted
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Disaster Hazard API
HAZARD_API_KEY=your_hazard_api_key_here
LANDSLIDE_API_URL=https://api.logainer.gov.in/hazard
LANDSLIDE_API_KEY=your_landslide_api_key_here

# Routing Engine (OSRM)
OSRM_BASE_URL=https://router.project-osrm.org

# GIS Mapping & Basemap Layers (Optional)
VITE_CARTO_API_KEY=your_carto_api_key_here
